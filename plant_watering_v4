// =====================================================
// PIN CONFIGURATION
// =====================================================

#define SOIL_PIN       A0
#define RELAY_PIN      D5
#define STATUS_LED_PIN D6
#define SETUP_BUTTON   D7


// =====================================================
// LCD
// =====================================================

LiquidCrystal_I2C lcd(0x27, 16, 2);
const int LCD_COLS = 16;


// =====================================================
// SOIL CALIBRATION
// IMPORTANT: CHANGE THESE AFTER TESTING YOUR SENSOR
// =====================================================

#define SOIL_DRY_VALUE 885
#define SOIL_WET_VALUE 440


// =====================================================
// DEFAULT SETTINGS
// =====================================================

int  moistureThreshold = 35;   // %
int  wateringDuration  = 10;   // seconds
bool autoMode           = true;
bool pumpState           = false;

const int HYSTERESIS = 3;


// =====================================================
// PUMP START REASON
// =====================================================

enum PumpReason { PUMP_IDLE, PUMP_AUTO, PUMP_MANUAL };
PumpReason pumpReason = PUMP_IDLE;


// =====================================================
// TIMERS
// =====================================================

BlynkTimer timer;
unsigned long pumpStartTime = 0;
const unsigned long MAX_PUMP_RUNTIME = 30000UL; // ms, absolute safety cap

// Grace period: auto-watering won't kick in until this long
// after the main screen (soil %) first appears on the LCD.
const unsigned long AUTO_PUMP_START_DELAY_MS = 30000UL; // 30s
unsigned long mainScreenStartTime = 0;


// =====================================================
// SETUP BUTTON STATE (debounce + long-press)
// =====================================================

bool buttonPressed        = false;
unsigned long buttonDownAt = 0;
bool longPressHandled     = false;

const unsigned long LONG_PRESS_MS = 3000UL;
const unsigned long DEBOUNCE_MS   = 50UL;
unsigned long lastButtonChange    = 0;
int lastButtonRaw = HIGH;


// =====================================================
// NON-BLOCKING STARTUP SCREEN STATE
//   LOGO -> WELCOME (static label + animated dots) -> DONE
// =====================================================

enum StartupStage { STAGE_LOGO, STAGE_WELCOME, STAGE_DONE };
StartupStage startupStage = STAGE_LOGO;
unsigned long startupStageStart = 0;

const unsigned long LOGO_STAGE_MS    = 4000UL;   // logo held longer now
const unsigned long WELCOME_STAGE_MS = 6000UL;   // <-- change this to adjust welcome screen duration

// "SYSTEM LOADING" label + dot animation (label prints ONCE,
// only the dots after it get redrawn, so nothing flickers).
const char* LOADING_LABEL = "SYSTEM LOADING"; // 14 chars
const int LOADING_LABEL_LEN = 14;
const int LOADING_DOTS_COL = LOADING_LABEL_LEN; // dots start right after the label
const int LOADING_DOTS_MAX = LCD_COLS - LOADING_LABEL_LEN; // remaining columns (2)

unsigned long lastLoadingUpdate = 0;
int loadingDots = 0;
const unsigned long LOADING_ANIM_MS = 400UL;     // how fast the dots cycle


// =====================================================
// LCD HELPERS (CENTER-ALIGNED TEXT)
// =====================================================

String centerText(const String &text)
{
    int len = text.length();
    if (len >= LCD_COLS) return text.substring(0, LCD_COLS);

    int padLeft = (LCD_COLS - len) / 2;
    String out;
    for (int i = 0; i < padLeft; i++) out += ' ';
    out += text;
    while (out.length() < LCD_COLS) out += ' ';
    return out;
}

void lcdPrintCentered(int row, const String &text)
{
    lcd.setCursor(0, row);
    lcd.print(centerText(text));
}

// Prints "SYSTEM LOADING" once. Call only when entering the
// welcome stage, never again during the animation.
void printLoadingLabelOnce()
{
    lcd.setCursor(0, 1);
    lcd.print(LOADING_LABEL);
}

// Redraws ONLY the dot characters after the fixed label, so the
// label itself never gets reprinted / never flickers.
void updateLoadingDotsOnly()
{
    if (millis() - lastLoadingUpdate < LOADING_ANIM_MS)
        return;

    lastLoadingUpdate = millis();

    String dots;
    for (int i = 0; i < loadingDots; i++) dots += '.';
    while (dots.length() < LOADING_DOTS_MAX) dots += ' '; // clear old dot(s)

    lcd.setCursor(LOADING_DOTS_COL, 1);
    lcd.print(dots);

    loadingDots = (loadingDots + 1) % (LOADING_DOTS_MAX + 1); // 0..max dots
}


// =====================================================
// PUMP CONTROL
// Both V1 (status value) and V5 (switch widget) are kept
// in sync with the REAL pump state, whether the pump was
// started by AUTO logic or a MANUAL tap.
// =====================================================

void startPump(PumpReason reason)
{
    if (pumpState) return;

    digitalWrite(RELAY_PIN, LOW);   // active-LOW relay

    pumpState     = true;
    pumpReason    = reason;
    pumpStartTime = millis();

    Blynk.virtualWrite(V1, 1);
    Blynk.virtualWrite(V5, 1);

    Serial.print("PUMP: ON (");
    Serial.print(reason == PUMP_AUTO ? "AUTO" : "MANUAL");
    Serial.println(")");
}

void stopPump()
{
    if (!pumpState) return;

    digitalWrite(RELAY_PIN, HIGH);  // active-LOW relay

    pumpState  = false;
    pumpReason = PUMP_IDLE;

    Blynk.virtualWrite(V1, 0);
    Blynk.virtualWrite(V5, 0);

    Serial.println("PUMP: OFF");
}


// =====================================================
// SOIL MOISTURE (no fault detection)
// =====================================================

int readMoisture()
{
    int raw = analogRead(SOIL_PIN);
    int moisture = map(raw, SOIL_DRY_VALUE, SOIL_WET_VALUE, 0, 100);
    return constrain(moisture, 0, 100);
}


// =====================================================
// BLYNK SOIL UPDATE
// =====================================================

void sendSoilData()
{
    int moisture = readMoisture();
    Blynk.virtualWrite(V0, moisture);

    Serial.print("Moisture: ");
    Serial.print(moisture);
    Serial.println("%");
}


// =====================================================
// AUTO WATERING (with hysteresis + startup grace period)
// =====================================================

void automaticWatering()
{
    if (!autoMode) return;

    // Don't even consider auto-watering until the main screen
    // has been up and showing soil % for a while -- prevents
    // the pump from snapping on right at boot.
    if (startupStage != STAGE_DONE) return;
    if (millis() - mainScreenStartTime < AUTO_PUMP_START_DELAY_MS) return;

    int moisture = readMoisture();

    if (!pumpState && moisture < (moistureThreshold - HYSTERESIS))
    {
        Serial.println("AUTO: Soil is dry");
        startPump(PUMP_AUTO);
    }
    else if (pumpState && pumpReason == PUMP_AUTO &&
             moisture >= (moistureThreshold + HYSTERESIS))
    {
        Serial.println("AUTO: Soil is wet");
        stopPump();
    }
}


// =====================================================
// PUMP SAFETY (runtime caps only)
// =====================================================

void pumpSafety()
{
    if (!pumpState) return;

    unsigned long elapsed = millis() - pumpStartTime;

    if (elapsed >= MAX_PUMP_RUNTIME)
    {
        Serial.println("SAFETY: Pump timeout (absolute max)");
        stopPump();
        return;
    }

    unsigned long wateringTimeMs = wateringDuration * 1000UL;

    if (elapsed >= wateringTimeMs)
    {
        Serial.println("SAFETY: Watering duration complete");
        stopPump();
    }
}


// =====================================================
// KEEP APP DASHBOARD IN SYNC
// (both status value AND switch widget)
// =====================================================

void resyncDashboard()
{
    Blynk.virtualWrite(V1, pumpState ? 1 : 0);
    Blynk.virtualWrite(V5, pumpState ? 1 : 0);
}


// =====================================================
// LCD NORMAL SCREEN
//   Row 0: SOIL:xx%   (mode letter, centered)   W:OK/NO
//   Row 1: pump status + threshold (centered)
// =====================================================

void updateLCD()
{
    if (startupStage != STAGE_DONE) return; // don't fight logo/welcome screens

    int moisture = readMoisture();
    lcd.clear();

    // ---- Row 0 ----
    String left  = "SOIL:" + String(moisture) + "%";
    String right = Blynk.connected() ? "W:OK" : "W:NO";
    String mode  = autoMode ? "A" : "M";

    lcd.setCursor(0, 0);
    lcd.print(left);

    // Clear everything after the left text first.
    for (int c = left.length(); c < LCD_COLS; c++)
    {
        lcd.setCursor(c, 0);
        lcd.print(' ');
    }

    // Place the mode letter centered in the gap between
    // the left text and the right-hand WiFi tag.
    int middleWidth = LCD_COLS - left.length() - right.length();
    int modeCol = left.length() + max(0, (middleWidth - (int)mode.length()) / 2);
    lcd.setCursor(modeCol, 0);
    lcd.print(mode);

    // Right-hand WiFi status tag.
    lcd.setCursor(LCD_COLS - right.length(), 0);
    lcd.print(right);

    // ---- Row 1: pump status + threshold, centered ----
    String line1 = "PUMP:" + String(pumpState ? "ON" : "OFF") +
                   " T:" + String(moistureThreshold) + "%";
    lcdPrintCentered(1, line1);
}


// =====================================================
// NON-BLOCKING STARTUP FLOW: LOGO -> WELCOME -> DONE
// (WiFi/Blynk connect in the background the whole time)
// =====================================================

void startupTask()
{
    unsigned long now = millis();

    if (startupStage == STAGE_LOGO)
    {
        if (startupStageStart == 0)
        {
            lcd.clear();
            lcdPrintCentered(0, "PLAN2PROTOTYPE");
            lcdPrintCentered(1, "IoT SMART PLANT");
            startupStageStart = now;
        }
        else if (now - startupStageStart >= LOGO_STAGE_MS)
        {
            startupStage = STAGE_WELCOME;
            startupStageStart = 0;
        }
    }
    else if (startupStage == STAGE_WELCOME)
    {
        if (startupStageStart == 0)
        {
            lcd.clear();
            lcdPrintCentered(0, "WELCOME!");
            printLoadingLabelOnce();   // printed ONCE
            startupStageStart = now;
            lastLoadingUpdate = 0;
            loadingDots       = 0;
        }
        else if (now - startupStageStart >= WELCOME_STAGE_MS)
        {
            startupStage = STAGE_DONE;
            mainScreenStartTime = now; // starts the 30s auto-pump grace period
            updateLCD();
            startupStageStart = 0;
        }
        else
        {
            updateLoadingDotsOnly(); // only the dots redraw, label stays put
        }
    }
    // STAGE_DONE: updateLCD() (called from systemTask) owns the screen.
}


// =====================================================
// BLYNK MODE  (V2: 0 = AUTO, 1 = MANUAL)
// =====================================================

BLYNK_WRITE(V2)
{
    int value = param.asInt();

    if (value == 0) { autoMode = true;  Serial.println("MODE: AUTO"); }
    else            { autoMode = false; Serial.println("MODE: MANUAL"); }

    stopPump();
}


// =====================================================
// BLYNK MANUAL PUMP (V5)
// =====================================================

BLYNK_WRITE(V5)
{
    int value = param.asInt();

    if (!autoMode)
    {
        if (value == 1) startPump(PUMP_MANUAL);
        else            stopPump();
    }
    else
    {
        // Don't let a stray/accidental tap in AUTO mode kill an
        // auto-controlled pump run -- just re-sync the switch.
        Blynk.virtualWrite(V5, pumpState ? 1 : 0);
    }
}


// =====================================================
// MOISTURE THRESHOLD (V3)
// =====================================================

BLYNK_WRITE(V3)
{
    moistureThreshold = constrain(param.asInt(), 0, 100);
    Serial.print("Threshold: ");
    Serial.println(moistureThreshold);
}


// =====================================================
// WATERING DURATION (V4)
// =====================================================

BLYNK_WRITE(V4)
{
    wateringDuration = constrain(param.asInt(), 1, 60);
    Serial.print("Watering Duration: ");
    Serial.print(wateringDuration);
    Serial.println(" sec");
}


// =====================================================
// RE-SYNC STATE TO APP ON (RE)CONNECT
// =====================================================

BLYNK_CONNECTED()
{
    Blynk.virtualWrite(V1, pumpState ? 1 : 0);
    Blynk.virtualWrite(V2, autoMode ? 0 : 1);
    Blynk.virtualWrite(V3, moistureThreshold);
    Blynk.virtualWrite(V4, wateringDuration);
    Blynk.virtualWrite(V5, pumpState ? 1 : 0);

    Serial.println("Blynk connected: state re-synced to app");
}


// =====================================================
// SETUP / MANUAL BUTTON
//   Short press (< 3s)  -> manual pump toggle (MANUAL mode only)
//   Long press  (>= 3s) -> restart the device
// =====================================================

void handleSetupButton()
{
    int raw = digitalRead(SETUP_BUTTON); // LOW = pressed (INPUT_PULLUP)
    unsigned long now = millis();

    if (raw != lastButtonRaw)
    {
        lastButtonChange = now;
        lastButtonRaw = raw;
    }

    if (now - lastButtonChange < DEBOUNCE_MS) return;

    bool isDown = (raw == LOW);

    if (isDown && !buttonPressed)
    {
        buttonPressed = true;
        buttonDownAt = now;
        longPressHandled = false;
    }
    else if (isDown && buttonPressed)
    {
        if (!longPressHandled && (now - buttonDownAt >= LONG_PRESS_MS))
        {
            longPressHandled = true;

            Serial.println("SETUP BUTTON: Long press -> restarting device");

            lcd.clear();
            lcdPrintCentered(0, "RESTARTING...");

            stopPump();
            delay(500);
            ESP.restart();
        }
    }
    else if (!isDown && buttonPressed)
    {
        buttonPressed = false;

        if (!longPressHandled)
        {
            if (!autoMode)
            {
                if (pumpState) stopPump();
                else           startPump(PUMP_MANUAL);
            }
            else
            {
                Serial.println("SETUP BUTTON: Short press ignored (AUTO mode active)");
            }
        }
    }
}


// =====================================================
// STATUS LED (solid = connected, blinking = not connected)
// =====================================================

void updateStatusLED()
{
    static unsigned long lastBlink = 0;
    static bool ledState = false;

    if (Blynk.connected())
    {
        digitalWrite(STATUS_LED_PIN, HIGH);
        return;
    }

    if (millis() - lastBlink >= 500)
    {
        lastBlink = millis();
        ledState = !ledState;
        digitalWrite(STATUS_LED_PIN, ledState);
    }
}


// =====================================================
// PERIODIC TASK (every 2s)
// =====================================================

void systemTask()
{
    sendSoilData();
    automaticWatering();
    pumpSafety();
    resyncDashboard();
    updateLCD();   // no-op unless startupStage == STAGE_DONE
}


// =====================================================
// SETUP
// =====================================================

void setup()
{
    Serial.begin(115200);
    delay(100);

    pinMode(RELAY_PIN, OUTPUT);
    digitalWrite(RELAY_PIN, HIGH); // OFF (active-LOW relay)

    pinMode(STATUS_LED_PIN, OUTPUT);
    digitalWrite(STATUS_LED_PIN, LOW);

    pinMode(SETUP_BUTTON, INPUT_PULLUP);
    lastButtonRaw = digitalRead(SETUP_BUTTON);

    lcd.init();
    lcd.backlight();

    // Kick off WiFi + Blynk connection in the background.
    // These calls return immediately -- the actual handshake
    // happens gradually inside Blynk.run() in loop(), so the
    // logo/welcome/main screens are never blocked by it.
    WiFi.mode(WIFI_STA);
    WiFi.begin(ssid, pass);
    Blynk.config(auth);

    timer.setInterval(2000L, systemTask);
}


// =====================================================
// LOOP
// =====================================================

void loop()
{
    Blynk.run();
    timer.run();

    startupTask();       // logo -> welcome (loading) -> normal screen
    handleSetupButton();
    updateStatusLED();
}
